/*
 * Library Management System - Main Stylesheet
 * 
 * Provides consistent styling across all UI components
 * including colors, fonts, spacing, and widget-specific styling
 */

/* ============================================================
   GLOBAL SETTINGS
   ============================================================ */

* {
    font-family: "Segoe UI", "Arial", "Helvetica", sans-serif;
    font-size: 9pt;
}

QWidget {
    background-color: #f5f6fa;
    color: #2c3e50;
}

/* ============================================================
   MAIN WINDOW
   ============================================================ */

MainWindow {
    background-color: #f5f6fa;
}

QMainWindow {
    background-color: #f5f6fa;
}

/* ============================================================
   TAB WIDGET
   ============================================================ */

QTabWidget::pane {
    border: 1px solid #dcdde1;
    background-color: #ffffff;
    border-radius: 4px;
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    background-color: #eaecee;
}

QTabBar::tab {
    background-color: #eaecee;
    color: #2c3e50;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #bdc3c7;
    border-bottom: none;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #3498db;
    border-bottom: 2px solid #ffffff;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #d5dbdb;
    color: #3498db;
}

/* ============================================================
   BUTTONS
   ============================================================ */

QPushButton {
    background-color: #3498db;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #21618c;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

/* Primary action buttons */
QPushButton[objectName="primaryButton"] {
    background-color: #3498db;
    font-weight: 600;
}

/* Danger buttons */
QPushButton[objectName="dangerButton"] {
    background-color: #e74c3c;
}

QPushButton[objectName="dangerButton"]:hover {
    background-color: #c0392b;
}

/* Success buttons */
QPushButton[objectName="successButton"] {
    background-color: #27ae60;
}

QPushButton[objectName="successButton"]:hover {
    background-color: #229954;
}

/* Secondary buttons */
QPushButton[objectName="secondaryButton"] {
    background-color: #95a5a6;
}

QPushButton[objectName="secondaryButton"]:hover {
    background-color: #7f8c8d;
}

/* ============================================================
   LINE EDIT
   ============================================================ */

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 2px solid #3498db;
}

QLineEdit:disabled {
    background-color: #ecf0f1;
    color: #7f8c8d;
}

QLineEdit:hover {
    border: 1px solid #95a5a6;
}

/* ============================================================
   COMBO BOX
   ============================================================ */

QComboBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 100px;
}

QComboBox:hover {
    border: 1px solid #95a5a6;
}

QComboBox:focus {
    border: 2px solid #3498db;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border: 5px solid transparent;
    border-top: 8px solid #7f8c8d;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    selection-background-color: #3498db;
    selection-color: #ffffff;
}

/* ============================================================
   SPIN BOX
   ============================================================ */

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 10px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #3498db;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #ecf0f1;
    border: none;
    border-top-right-radius: 4px;
    width: 20px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #ecf0f1;
    border: none;
    border-bottom-right-radius: 4px;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #d5dbdb;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border: 4px solid transparent;
    border-bottom: 6px solid #7f8c8d;
    margin: 2px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border: 4px solid transparent;
    border-top: 6px solid #7f8c8d;
    margin: 2px;
}

/* ============================================================
   DATE EDIT
   ============================================================ */

QDateEdit {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 10px;
}

QDateEdit:focus {
    border: 2px solid #3498db;
}

QDateEdit::drop-down {
    border: none;
    width: 20px;
}

QDateEdit::down-arrow {
    image: none;
    border: 5px solid transparent;
    border-top: 8px solid #7f8c8d;
    margin-right: 5px;
}

QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
}

QCalendarWidget QTableView {
    background-color: #ffffff;
    selection-background-color: #3498db;
    selection-color: #ffffff;
}

/* ============================================================
   TABLE WIDGET / TABLE VIEW
   ============================================================ */

QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 4px;
    gridline-color: #ecf0f1;
    selection-background-color: #3498db;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 6px;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #3498db;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #ecf0f1;
    color: #2c3e50;
    padding: 8px;
    border: none;
    border-right: 1px solid #dcdde1;
    border-bottom: 1px solid #dcdde1;
    font-weight: 600;
}

QHeaderView::section:first {
    border-top-left-radius: 4px;
}

QHeaderView::section:last {
    border-top-right-radius: 4px;
}

QHeaderView::section:hover {
    background-color: #d5dbdb;
}

/* Vertical header */
QHeaderView {
    background-color: #ecf0f1;
}

/* ============================================================
   GROUP BOX
   ============================================================ */

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 20px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 8px;
    color: #2c3e50;
}

/* ============================================================
   LABELS
   ============================================================ */

QLabel {
    color: #2c3e50;
}

QLabel[objectName="titleLabel"] {
    font-size: 18pt;
    font-weight: bold;
    color: #2c3e50;
}

QLabel[objectName="subtitleLabel"] {
    font-size: 12pt;
    font-weight: 600;
    color: #7f8c8d;
}

QLabel[objectName="infoLabel"] {
    color: #7f8c8d;
    font-style: italic;
}

QLabel[objectName="warningLabel"] {
    color: #e67e22;
    font-weight: 600;
}

QLabel[objectName="errorLabel"] {
    color: #e74c3c;
    font-weight: 600;
}

QLabel[objectName="successLabel"] {
    color: #27ae60;
    font-weight: 600;
}

/* ============================================================
   TEXT EDIT
   ============================================================ */

QTextEdit {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
}

QTextEdit:focus {
    border: 2px solid #3498db;
}

/* ============================================================
   CHECK BOX
   ============================================================ */

QCheckBox {
    spacing: 8px;
    color: #2c3e50;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #bdc3c7;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border: 2px solid #95a5a6;
}

QCheckBox::indicator:checked {
    background-color: #3498db;
    border: 2px solid #3498db;
    image: none;
}

QCheckBox::indicator:checked::after {
    content: "✓";
    color: white;
}

/* ============================================================
   SCROLL BAR
   ============================================================ */

QScrollBar:vertical {
    background-color: #ecf0f1;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #ecf0f1;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #bdc3c7;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ============================================================
   SCROLL AREA
   ============================================================ */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ============================================================
   FRAME
   ============================================================ */

QFrame {
    background-color: transparent;
}

QFrame[objectName="separatorFrame"] {
    background-color: #dcdde1;
    max-height: 1px;
    border: none;
}

QFrame[objectName="cardFrame"] {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 12px;
}

/* ============================================================
   DIALOG
   ============================================================ */

QDialog {
    background-color: #f5f6fa;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #2c3e50;
}

/* ============================================================
   PROGRESS BAR
   ============================================================ */

QProgressBar {
    background-color: #ecf0f1;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #2c3e50;
}

QProgressBar::chunk {
    background-color: #3498db;
    border-radius: 4px;
}

/* ============================================================
   TOOLTIP
   ============================================================ */

QToolTip {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 9pt;
}

/* ============================================================
   MENU
   ============================================================ */

QMenuBar {
    background-color: #ecf0f1;
    border: none;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3498db;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3498db;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #dcdde1;
    margin: 4px 8px;
}

/* ============================================================
   STATUS BAR
   ============================================================ */

QStatusBar {
    background-color: #ecf0f1;
    border-top: 1px solid #dcdde1;
    color: #2c3e50;
}

/* ============================================================
   FORM LAYOUT SPECIFIC
   ============================================================ */

QFormLayout {
    spacing: 8px;
}

QFormLayout label {
    color: #2c3e50;
    font-weight: 500;
}

/* ============================================================
   SPECIFIC WIDGET STYLES
   ============================================================ */

/* Search inputs */
QLineEdit[objectName="searchInput"] {
    border: 2px solid #dcdde1;
    background-color: #ffffff;
    font-size: 10pt;
    padding: 8px 12px;
}

QLineEdit[objectName="searchInput"]:focus {
    border: 2px solid #3498db;
}

/* Info card frames */
QFrame[objectName="infoCard"] {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 8px;
    padding: 16px;
}

QFrame[objectName="infoCard"][variant="success"] {
    background-color: #d4edda;
    border: 1px solid #c3e6cb;
}

QFrame[objectName="infoCard"][variant="warning"] {
    background-color: #fff3cd;
    border: 1px solid #ffeaa7;
}

QFrame[objectName="infoCard"][variant="danger"] {
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
}

/* Button groups */
QDialogButtonBox {
    background-color: transparent;
}

/* ============================================================
   ANIMATION SUPPORT (for future use)
   ============================================================ */

/* This section is reserved for any animation styles
   that might be added to enhance user experience */

/* ============================================================
   ACCESSIBILITY
   ============================================================ */

/* Focus indicators for keyboard navigation */
QPushButton:focus, QLineEdit:focus, QTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus {
    outline: 2px solid #3498db;
    outline-offset: 2px;
}

/* High contrast mode support could be added here */

/* ============================================================
   PRINT STYLES (for future report printing)
   ============================================================ */

/* Placeholder for print-specific styles */
